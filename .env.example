# ==========================================
# Configuration du déploiement Docker / Portainer
# ==========================================

# Port d'accès sur votre machine hôte (NAS, VPS, PC...)
# Changez cette valeur par n'importe quel port libre de votre choix (ex: 3080, 8085, 3456...)
APP_PORT=3080

# (Optionnel) Clé d'API Google Gemini si vous souhaitez la définir au niveau du conteneur
# Vous pouvez aussi la saisir directement dans l'interface de l'application (icône écrou ⚙️)
# GEMINI_API_KEY=AIzaSy...
